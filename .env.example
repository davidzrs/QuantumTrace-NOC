# Backend (read by pydantic-settings, prefix QT_)
QT_API_KEY=                       # empty = open API (local dev); set in production
QT_CORS_ORIGINS=http://localhost:5173
QT_CORS_ORIGIN_REGEX=             # e.g. https://quantumtrace-.*\.vercel\.app for preview deploys
QT_MAX_UPLOAD_MB=50
# QT_SAMPLES_DIR=./samples        # defaults to <repo>/samples

# Frontend: see frontend/apps/web/.env.example

# "Fix me" on code findings: the API sends the snippet to Gemini. Off when unset.
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# QT_AI_MODEL=gemini-flash-latest   # better fixes, but 5-30 s and 20 free requests a day
# QT_AI_THINKING=low
