{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**,Dockerfile}"
    }
  }
}
