{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run QuantumTrace extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode",
        "${workspaceFolder}/samples/sample-repos"
      ],
      "outFiles": ["${workspaceFolder}/extensions/vscode/dist/**/*.js"],
      "preLaunchTask": "Build QuantumTrace extension"
    }
  ]
}
