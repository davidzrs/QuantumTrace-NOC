# Base URL of the QuantumTrace API (Fly.io in production)
VITE_API_URL=http://localhost:8000
# Optional. Anything in VITE_* ships in the public bundle: only use a low-privilege demo key.
VITE_API_KEY=
# Optional accounts (Firebase web config, public by design). Leave empty to hide "Account".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
