{
  "openapi": "3.1.0",
  "info": {
    "title": "QuantumTrace API",
    "description": "Discover, classify and report quantum-vulnerable cryptography (CBOM).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rules": {
      "get": {
        "tags": [
          "rules"
        ],
        "summary": "List Rules",
        "operationId": "listRules",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rule"
                  },
                  "title": "Response Listrules"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/samples": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "List Samples",
        "operationId": "listSamples",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sample"
                  },
                  "title": "Response Listsamples"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/sample": {
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Scan Sample",
        "operationId": "scanSample",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SampleScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans": {
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Scan Upload",
        "operationId": "scanUpload",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scanUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "List Scans",
        "operationId": "listScans",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "description": "Scan ids to summarise. There is deliberately no way to list every scan: each client keeps the ids of the scans it ran.",
              "title": "Ids"
            },
            "description": "Scan ids to summarise. There is deliberately no way to list every scan: each client keeps the ids of the scans it ran."
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanSummary"
                  },
                  "title": "Response Listscans"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/github": {
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Scan Github",
        "description": "Scan a public GitHub repository without uploading it: the API downloads the commit's\narchive from GitHub and reads only the files a scanner understands. The target names the\nexact commit, and code findings link to their line on GitHub (`context.source_url`).",
        "operationId": "scanGithub",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GithubScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/probes/tls": {
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Probe Tls",
        "description": "Handshake with a live host and classify what it negotiates: TLS version, key exchange\n(classical or hybrid ML-KEM), cipher, what it still permits over TLS 1.2, and the leaf\ncertificate key. Public addresses only, unless the API runs with QT_PROBE_PRIVATE.",
        "operationId": "probeTls",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TlsProbeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{scan_id}": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "Get Scan",
        "operationId": "getScan",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "scans"
        ],
        "summary": "Delete Scan",
        "description": "Whoever holds a scan's id can read it, so they can also delete it. Idempotent.",
        "operationId": "deleteScan",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{scan_id}/cbom": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "Get Scan Cbom",
        "operationId": "getScanCbom",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Getscancbom"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_scanUpload": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "Files or .zip archives to scan"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_scanUpload"
      },
      "Classification": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "primitive": {
            "$ref": "#/components/schemas/Primitive"
          },
          "threat": {
            "$ref": "#/components/schemas/QuantumThreat"
          },
          "tier": {
            "$ref": "#/components/schemas/RiskTier"
          },
          "classically_broken": {
            "type": "boolean",
            "title": "Classically Broken",
            "default": false
          },
          "hndl": {
            "type": "boolean",
            "title": "Hndl",
            "description": "Harvest-now, decrypt-later: Shor breaks it and it protects confidentiality (key exchange, key transport, public-key encryption), so data recorded today can be decrypted later. Signatures, certificates and digests are never exposed this way.",
            "default": false
          },
          "nist_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nist Reference"
          },
          "replacement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement"
          },
          "oid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oid"
          },
          "classical_security_bits": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classical Security Bits"
          },
          "nist_quantum_level": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 6.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Nist Quantum Level",
            "description": "NIST PQC security category; 0 = broken by Shor"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "name",
          "primitive",
          "threat",
          "tier",
          "classically_broken",
          "hndl",
          "nist_reference",
          "replacement",
          "oid",
          "classical_security_bits",
          "nist_quantum_level",
          "rationale"
        ],
        "title": "Classification"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Confidence",
        "description": "How sure the scanner is about the identification (not about the risk)."
      },
      "CryptoAsset": {
        "properties": {
          "observed": {
            "type": "string",
            "title": "Observed",
            "description": "Value exactly as seen in the source, e.g. 'RSA_2048'"
          },
          "algorithm": {
            "type": "string",
            "title": "Algorithm",
            "description": "Canonical name or alias resolvable by the classifier"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant",
            "description": "Precise form, e.g. AES-128-GCM, X25519, P-256 (display/CBOM)"
          },
          "key_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Size"
          },
          "usage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usage",
            "description": "e.g. SIGN_VERIFY, tls-key-exchange"
          },
          "observation": {
            "$ref": "#/components/schemas/Observation",
            "default": "configured"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence",
            "default": "high"
          },
          "exposure": {
            "$ref": "#/components/schemas/Exposure",
            "default": "unknown"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "more_evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "More Evidence",
            "description": "Further places with the identical asset (e.g. repeat sessions to one server)"
          }
        },
        "type": "object",
        "required": [
          "observed",
          "algorithm",
          "variant",
          "key_size",
          "usage",
          "observation",
          "confidence",
          "exposure",
          "flags",
          "evidence",
          "more_evidence"
        ],
        "title": "CryptoAsset",
        "description": "A raw detection emitted by a scanner, before classification."
      },
      "Evidence": {
        "properties": {
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "location": {
            "type": "string",
            "title": "Location",
            "description": "File path, cloud ARN or network flow (src:port -> dst:port)"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "column": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column",
            "description": "1-based column where the match starts"
          },
          "end_column": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Column",
            "description": "1-based column just past the match; absent when `observed` isn't on the line"
          },
          "snippet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet",
            "description": "Source lines around `line` (code evidence), dedented"
          },
          "snippet_start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet Start Line",
            "description": "Line number of the snippet's first line"
          },
          "context": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "source_type",
          "location",
          "line",
          "column",
          "end_column",
          "snippet",
          "snippet_start_line",
          "context"
        ],
        "title": "Evidence",
        "description": "Where an asset was observed. Enough to trace a finding back to its origin."
      },
      "Exposure": {
        "type": "string",
        "enum": [
          "internet",
          "internal",
          "unknown"
        ],
        "title": "Exposure"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "asset": {
            "$ref": "#/components/schemas/CryptoAsset"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          }
        },
        "type": "object",
        "required": [
          "id",
          "asset",
          "classification"
        ],
        "title": "Finding"
      },
      "GithubScanRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "title": "Url",
            "description": "A public repository, e.g. https://github.com/owner/repo, or a branch, tag, commit or folder in it: https://github.com/owner/repo/tree/main/src"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "GithubScanRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "max_upload_mb": {
            "type": "integer",
            "title": "Max Upload Mb",
            "description": "Largest request a scan accepts, after compression"
          },
          "max_unpacked_mb": {
            "type": "integer",
            "title": "Max Unpacked Mb",
            "description": "Largest total a scan accepts once .zip and .gz uploads are unpacked. Clients that see this field may gzip each file and append .gz to its name."
          },
          "persistent": {
            "type": "boolean",
            "title": "Persistent",
            "description": "Whether scan history survives an API restart"
          },
          "max_repo_mb": {
            "type": "integer",
            "title": "Max Repo Mb",
            "description": "Largest GitHub repository zip that /scans/github downloads"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "max_upload_mb",
          "max_unpacked_mb",
          "persistent",
          "max_repo_mb"
        ],
        "title": "Health"
      },
      "Observation": {
        "type": "string",
        "enum": [
          "negotiated",
          "configured",
          "in-code",
          "permitted",
          "offered"
        ],
        "title": "Observation",
        "description": "How strongly the input proves the primitive is in use."
      },
      "Primitive": {
        "type": "string",
        "enum": [
          "signature",
          "pke",
          "kem",
          "key-agree",
          "block-cipher",
          "stream-cipher",
          "ae",
          "hash",
          "mac",
          "kdf",
          "protocol",
          "other"
        ],
